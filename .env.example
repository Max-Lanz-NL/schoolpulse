# Publieke browserconfiguratie (de anon key is ontworpen om publiek te zijn; gebruik nooit de service-role key).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only aliases used by /readyz. Never prefix secrets or private keys with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Required before pilot release: configure these only after selecting a real
# monitoring provider. Values remain server-side; recipients live in provider config.
SCHOOLPULSE_MONITORING_PROVIDER=
SCHOOLPULSE_MONITORING_ENDPOINT=
SCHOOLPULSE_MONITORING_TOKEN=
SCHOOLPULSE_MONITORING_ALERT_ROUTE=
SCHOOLPULSE_ENVIRONMENT=local
SCHOOLPULSE_RELEASE=development

# Alleen voor lokale acceptatietests tegen een niet-productie Supabase-project.
VITE_FORCE_PRODUCTION_APP=false

# Tijdelijke e-mail-only toegang op app.schoolpulse.nl; zet op false vóór echte gebruikers/data of Azure SSO.
VITE_EMAIL_ONLY_TEST_MODE=true

# Laat deze standaardwaarden staan voor Schoolpulse, of vervang ze bij een domeinverhuizing.
VITE_MARKETING_ORIGIN=https://schoolpulse.nl
VITE_MARKETING_WWW_ORIGIN=https://www.schoolpulse.nl
VITE_APP_ORIGIN=https://app.schoolpulse.nl
VITE_ADMIN_ORIGIN=https://admin.schoolpulse.nl
VITE_DEMO_ORIGIN=https://demo.schoolpulse.nl
VITE_TEST_ORIGIN=https://test.schoolpulse.nl
VITE_API_ORIGIN=https://api.schoolpulse.nl
VITE_DOCS_ORIGIN=https://docs.schoolpulse.nl

PORT=3000
